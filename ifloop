# 1. Classify numbers 1-20 as even/odd, and flag multiples of 3 and 5
print("=== Number classification ===")
for n in range(1, 21):
    if n % 15 == 0:
        label = "FizzBuzz"
    elif n % 3 == 0:
        label = "Fizz"
    elif n % 5 == 0:
        label = "Buzz"
    elif n % 2 == 0:
        label = "even"
    else:
        label = "odd"
    print(f"{n:2}: {label}")


# 2. Find all prime numbers up to 50 using nested for loops
print("\n=== Primes up to 50 ===")
primes = []
for candidate in range(2, 51):
    is_prime = True
    for divisor in range(2, int(candidate ** 0.5) + 1):
        if candidate % divisor == 0:
            is_prime = False
            break
    if is_prime:
        primes.append(candidate)
print(primes)


# 3. Letter grade calculator over a list of scores
print("\n=== Grade calculator ===")
scores = [95, 82, 71, 64, 58, 90, 47, 88, 73, 100]
for score in scores:
    if score >= 90:
        grade = "A"
    elif score >= 80:
        grade = "B"
    elif score >= 70:
        grade = "C"
    elif score >= 60:
        grade = "D"
    else:
        grade = "F"
    print(f"Score {score:3} -> Grade {grade}")


# 4. Simple triangle pattern using nested for loops
print("\n=== Triangle pattern ===")
rows = 5
for i in range(1, rows + 1):
    row = ""
    for j in range(i):
        row += "*"
    print(row)


# 5. Sum only the numbers divisible by 3 or 7 in a range
print("\n=== Sum of multiples of 3 or 7 (1-100) ===")
total = 0
for i in range(1, 101):
    if i % 3 == 0 or i % 7 == 0:
        total += i
print(f"Total: {total}")


# 6. Find the largest and smallest value in a list without using min()/max()
print("\n=== Manual min/max ===")
values = [42, 17, 89, 3, 56, 91, 8, 23]
smallest = values[0]
largest = values[0]
for v in values:
    if v < smallest:
        smallest = v
    if v > largest:
        largest = v
print(f"List: {values}")
print(f"Smallest: {smallest}, Largest: {largest}")


# 7. Password strength checker
print("\n=== Password strength checker ===")
passwords = ["abc", "password1", "Str0ng!Pass", "12345678", "Aa1!aaaa"]
for pw in passwords:
    has_upper = False
    has_lower = False
    has_digit = False
    has_symbol = False

    for ch in pw:
        if ch.isupper():
            has_upper = True
        elif ch.islower():
            has_lower = True
        elif ch.isdigit():
            has_digit = True
        else:
            has_symbol = True

    if len(pw) < 8:
        strength = "too short"
    elif has_upper and has_lower and has_digit and has_symbol:
        strength = "strong"
    elif (has_upper or has_lower) and has_digit:
        strength = "medium"
    else:
        strength = "weak"

    print(f"{pw:15} -> {strength}")


# 8. Multiplication table using nested loops
print("\n=== Multiplication table (1-5) ===")
for i in range(1, 6):
    row_parts = []
    for j in range(1, 6):
        row_parts.append(f"{i * j:3}")
    print(" ".join(row_parts))


# 9. Count vowels and consonants in a sentence
print("\n=== Vowel/consonant counter ===")
sentence = "The quick brown fox jumps over the lazy dog"
vowels = 0
consonants = 0
for ch in sentence.lower():
    if ch in "aeiou":
        vowels += 1
    elif ch.isalpha():
        consonants += 1
print(f"Sentence: {sentence!r}")
print(f"Vowels: {vowels}, Consonants: {consonants}")


# 10. Simple bubble sort using nested for loops
print("\n=== Bubble sort ===")
data = [64, 34, 25, 12, 22, 11, 90]
print(f"Before: {data}")
n = len(data)
for i in range(n):
    for j in range(0, n - i - 1):
        if data[j] > data[j + 1]:
            data[j], data[j + 1] = data[j + 1], data[j]
print(f"After:  {data}")
